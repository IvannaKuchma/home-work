doctype html
html
  head
    meta(charset="utf-8")
    title Тест теми
    link(rel="icon", href="/favicon.ico")
    link(rel="stylesheet", href="/styles.css?v=1")
  body(class=theme)
    h1 Поточна тема: #{theme}

    form(action="/theme/set" method="POST")
      label(for="theme") Обери тему:
      select(name="theme")
        option(value="light" selected=theme==='light') Light
        option(value="dark" selected=theme==='dark') Dark
      button(type="submit") Зберегти
