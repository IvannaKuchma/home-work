doctype html
html
  head
    meta(charset="utf-8")
    title PUG Page
    link(rel="icon" href="/favicon.ico")
    link(rel="stylesheet", href="/styles.css")
  body(class=theme)
    header
      h1 PUG Сторінка
      p Тема: #{theme}
    .container
      a(href="/") ← Назад
      br
      a(href="/set-theme/light") 
        button.light-btn Встановити світлу тему
      a(href="/set-theme/dark") 
        button.dark-btn Встановити темну тему
